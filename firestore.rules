// Firestore security rules for mylink project
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public links collection – anyone can read, only authenticated users can write/update/delete their own links
    match /links/{docId} {
      // Public read
      allow read: if true;
      // Only logged‑in users can create a link
      allow create: if request.auth != null;
      // Only the owner (userId) can update or delete
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    // Profile document – 모든 사용자가 읽을 수 있게 함
    // 쓰기는 소유자만 허용
    match /profile/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

  }
}
